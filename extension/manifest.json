{
  "manifest_version": 3,
  "name": "Biligumi Connector",
  "version": "0.3.20",
  "description": "Embed Bangumi collection, rating, episode progress and OP/ED skip controls into Bilibili watch pages.",
  "permissions": [
    "storage",
    "tabs",
    "scripting"
  ],
  "minimum_chrome_version": "95",
  "host_permissions": [
    "https://www.bilibili.com/video/*",
    "https://www.bilibili.com/bangumi/play/*",
    "https://api.bgm.tv/*",
    "https://api.bgmapi.com/*",
    "https://bgm.tv/*",
    "https://raw.githubusercontent.com/krkr521/biligumi-connector/master/extension/manifest.json",
    "https://api.gitcode.com/api/v5/repos/krkr521/biligumi-connector/branches/master",
    "https://api.gitcode.com/api/v5/repos/krkr521/biligumi-connector/raw/extension/manifest.json"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/video/*",
        "https://www.bilibili.com/bangumi/play/*",
        "https://bgm.tv/subject/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "commands": {
    "skip-oped": {
      "suggested_key": {
        "default": "Alt+Shift+Right"
      },
      "description": "Skip OP/ED on the active or recent Bilibili video tab"
    }
  }
}
